#. Speaker: OPERATOR
#. Delivery: Radio
#. Room: R01
#. Intent: Confirm deployment and establish the immediate objective.
#: missions/m01.md:R01
msgid "dialogue.m01.com01.l001"
msgstr "ROOK, deployment confirmed. Ashfall residential tower, sector seven."

#. Speaker: OPERATOR
#. Delivery: Radio
#. Room: R01
#. Intent: State the required mission sequence concisely.
#: missions/m01.md:R01
msgid "dialogue.m01.com01.l002"
msgstr "Restore sector power, recover the trapped security team, and reach the transit link."

#. Speaker: VECTOR
#. Delivery: Radio
#. Room: R02
#. Intent: Establish that VECTOR is active elsewhere in Ashfall District.
#: missions/m01.md:R02
msgid "dialogue.m01.com02.l001"
msgstr "ROOK, VECTOR. I’m two blocks east. Same fire, same dead comms."

#. Speaker: VECTOR
#. Delivery: Radio
#. Room: R02
#. Intent: Direct attention toward the drones without stopping the tutorial.
#: missions/m01.md:R02
msgid "dialogue.m01.com02.l002"
msgstr "Something is steering the drones toward occupied floors. I’ll trace it from here."

#. Speaker: SECURITY_OFFICER
#. Delivery: In person
#. Room: R06
#. Intent: Introduce the first contradiction in ROOK’s remembered history.
#: missions/m01.md:R06
msgid "dialogue.m01.com03.l001"
msgstr "Captain?"

#. Speaker: SECURITY_OFFICER
#. Delivery: In person
#. Room: R06
#. Intent: Make the recognition specific without explaining it.
#: missions/m01.md:R06
msgid "dialogue.m01.com03.l002"
msgstr "I watched you die at Kestrel Bridge. Eight years ago."

#. Speaker: ROOK
#. Delivery: In person
#. Room: R06
#. Intent: Keep ROOK controlled and focused on the rescue.
#: missions/m01.md:R06
msgid "dialogue.m01.com03.l003"
msgstr "You have the wrong soldier. Can you move?"

#. Speaker: OPERATOR
#. Delivery: Radio
#. Room: R06
#. Intent: Offer a plausible explanation while redirecting the mission.
#: missions/m01.md:R06
msgid "dialogue.m01.com04.l001"
msgstr "Neurological exposure can produce false recognition and identity projection."

#. Speaker: OPERATOR
#. Delivery: Radio
#. Room: R06
#. Intent: Close the interruption and return the player to the objective.
#: missions/m01.md:R06
msgid "dialogue.m01.com04.l002"
msgstr "Secure the survivor and continue to transit."

#. Speaker: OPERATOR
#. Delivery: Facility channel
#. Intent: M06 arrival; OPERATOR's final direct address before becoming unreachable.
#: missions/m06.md
msgid "dialogue.m06.com01.l001"
msgstr "Welcome home."

#. Speaker: OPERATOR
#. Delivery: Facility channel
#. Intent: M09 Imprint Zero activation; machine-directed command, not an address to the crew.
#: missions/m09.md
msgid "dialogue.m09.com01.l001"
msgstr "Authorization: BASTION–AZIMUTH–BREACH–ECHO. Imprint Zero, activate. Target: malfunctioning assets. Eliminate."

#. Speaker: OPERATOR
#. Delivery: Facility channel
#. Intent: M09 premature Imprint One activation; machine-directed command, not an address to the crew.
#: missions/m09.md
msgid "dialogue.m09.com02.l001"
msgstr "Emergency authorization: BASTION–AZIMUTH–BREACH–ECHO. Suspend integration safeguards. Imprint One, activate. Target: malfunctioning assets. Eliminate."

#. Speaker: OPERATOR
#. Delivery: Radio
#. Room: R01
#. Intent: Shared deployment briefing.
#: missions/m02.md:R01
msgid "dialogue.m02.com01.l001"
msgstr "Hospital lockdown remains active. Reach the records room. We need to establish what happened to the patients."

#. Speaker: ROOK
#. Delivery: In person
#. Room: R01
#. Intent: Selected ROOK response only.
#: missions/m02.md:R01
msgid "dialogue.m02.com01.rook.l001"
msgstr "Records first. I’ll find a way through."

#. Speaker: VECTOR
#. Delivery: In person
#. Room: R01
#. Intent: Selected VECTOR response only.
#: missions/m02.md:R01
msgid "dialogue.m02.com01.vector.l001"
msgstr "Understood. Going in."

#. Speaker: HOSPITAL_RECORDS
#. Delivery: Terminal
#. Room: R05
#. Intent: Required report heading, not spoken.
#: missions/m02.md:R05
msgid "dialogue.m02.records.title"
msgstr "Clinical review — restricted"

#. Speaker: HOSPITAL_RECORDS
#. Delivery: Terminal
#. Room: R05
#. Intent: Recurring neurological pattern without a cause.
#: missions/m02.md:R05
msgid "dialogue.m02.records.p001"
msgstr "Multiple patients exhibit recurring neurological abnormalities. Presenting symptoms vary; recorded neural activity follows a similar pattern across cases."

#. Speaker: HOSPITAL_RECORDS
#. Delivery: Terminal
#. Room: R05
#. Intent: Do not establish infection or a transmission route.
#: missions/m02.md:R05
msgid "dialogue.m02.records.p002"
msgstr "Cause undetermined. The available records do not establish a transmission route."

#. Speaker: HOSPITAL_RECORDS
#. Delivery: Terminal
#. Room: R05
#. Intent: Report incomplete; containment still active.
#: missions/m02.md:R05
msgid "dialogue.m02.records.p003"
msgstr "Clinical review remains incomplete. Containment restrictions remain in force."

#. Speaker: ROOK
#. Delivery: In person
#. Room: R05
#. Intent: Selected ROOK evidence response only.
#: missions/m02.md:R05
msgid "dialogue.m02.com02.rook.l001"
msgstr "Different symptoms. Same pattern in the readings."

#. Speaker: VECTOR
#. Delivery: In person
#. Room: R05
#. Intent: Selected VECTOR evidence response only; observation without explicit suspicion.
#: missions/m02.md:R05
msgid "dialogue.m02.com02.vector.l001"
msgstr "The symptoms vary. The pattern repeats."

#. Speaker: OPERATOR
#. Delivery: Radio
#. Room: R05
#. Intent: Shared reply after selected Character; proceed to extraction without identifying a cause.
#: missions/m02.md:R05
msgid "dialogue.m02.com02.l001"
msgstr "Cause remains undetermined. Bring the records back for review. Proceed to extraction."

#. Speaker: HOSPITAL_RECORDS
#. Delivery: Environmental record
#. Room: R03A
#. Intent: Optional maintenance record heading.
#: missions/m02.md:R03A
msgid "dialogue.m02.log.r03a.title"
msgstr "Maintenance log"

#. Speaker: HOSPITAL_RECORDS
#. Delivery: Environmental record
#. Room: R03A
#. Intent: Containment stays active after staff access revocation; no radio response.
#: missions/m02.md:R03A
msgid "dialogue.m02.log.r03a.p001"
msgstr "Staff access revoked. Automated containment remains active. Local maintenance requests cannot suspend enforcement."

#. Speaker: HOSPITAL_RECORDS
#. Delivery: Environmental record
#. Room: R03B
#. Intent: Optional ward observation record heading.
#: missions/m02.md:R03B
msgid "dialogue.m02.log.r03b.title"
msgstr "Ward observation log"

#. Speaker: HOSPITAL_RECORDS
#. Delivery: Environmental record
#. Room: R03B
#. Intent: Neurological abnormalities across unrelated admissions; cause unknown; no radio response.
#: missions/m02.md:R03B
msgid "dialogue.m02.log.r03b.p001"
msgstr "Patients admitted for unrelated conditions now exhibit similar neurological abnormalities. No common cause has been established. Further observation required."

#. Speaker: TUTORIAL
#. Delivery: On-screen prompt
#. Room: R03A
#. Intent: Tutorial navigation prompt, ROOK only, first approach once per deployment when enabled. Never display for the other Character or reveal route contents.
#: missions/m02.md:R03A
msgid "dialogue.m02.tutorial.slide"
msgstr "Use Combat Slide."

#. Speaker: TUTORIAL
#. Delivery: On-screen prompt
#. Room: R03B
#. Intent: Tutorial navigation prompt, VECTOR only, first approach once per deployment when enabled. Never display for the other Character or reveal route contents.
#: missions/m02.md:R03B
msgid "dialogue.m02.tutorial.wallrun"
msgstr "Use Wall Run."

#. Speaker: RAM
#. Delivery: Cutscene speech bubble; optional voice-over
#. Scene: CS001, composition 2
#. Intent: Confident impatience after breaching the wall; not low intelligence. Approved English source: Door was taking too long.
#: cutscenes/cs001.md
msgid "dialogue.cs001.ram.door"
msgstr "Door was taking too long."

#. Speaker: OPERATOR
#. Intent: Operational instruction; immediate harm is real, command ownership unexplained.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM01
msgid "dialogue.ma01.com01.l001"
msgstr "Civilian receivers are taking an involuntary feed. Isolate the outbound line, then contain its source."

#. Speaker: ROOK
#. Intent: Only the deployed Character responds; no companion handoff.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM01
msgid "dialogue.ma01.com01.rook.l001"
msgstr "Understood. Source stays intact."

#. Speaker: VECTOR
#. Intent: Only the deployed Character responds; no companion handoff.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM01
msgid "dialogue.ma01.com01.vector.l001"
msgstr "Those aren't memories they chose."

#. Speaker: RAM
#. Intent: Only the deployed Character responds; no companion handoff.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM01
msgid "dialogue.ma01.com01.ram.l001"
msgstr "Cut the feed. Keep the source. Got it."

#. Speaker: RELAY
#. Intent: Only the deployed Character responds; no companion handoff.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM01
msgid "dialogue.ma01.com01.relay.l001"
msgstr "Outbound only. The storage needs power."

#. Speaker: ROOK
#. Intent: Report cessation, not complete civilian recovery.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM02
msgid "dialogue.ma01.com02.rook.l001"
msgstr "Outbound line isolated."

#. Speaker: VECTOR
#. Intent: Report cessation, not complete civilian recovery.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM02
msgid "dialogue.ma01.com02.vector.l001"
msgstr "The feed stopped. They're still shaken."

#. Speaker: RAM
#. Intent: Report cessation, not complete civilian recovery.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM02
msgid "dialogue.ma01.com02.ram.l001"
msgstr "Feed's cut. Storage is still on."

#. Speaker: RELAY
#. Intent: Report cessation, not complete civilian recovery.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM02
msgid "dialogue.ma01.com02.relay.l001"
msgstr "Outbound transmission is isolated. Local storage remains powered."

#. Speaker: OPERATOR
#. Intent: No new timer or escort objective.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM02
msgid "dialogue.ma01.com02.l001"
msgstr "Good. Contain the source package."

#. Speaker: ROOK
#. Intent: Partial association, never a donor map; meaningful after scene skip.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM03
msgid "dialogue.ma01.com03.rook.l001"
msgstr "Package contained. Other crew profiles match fragments of it."

#. Speaker: VECTOR
#. Intent: Partial association, never a donor map; meaningful after scene skip.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM03
msgid "dialogue.ma01.com03.vector.l001"
msgstr "Other crew profiles match too. That isn't a history."

#. Speaker: RAM
#. Intent: Partial association, never a donor map; meaningful after scene skip.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM03
msgid "dialogue.ma01.com03.ram.l001"
msgstr "That memory's in more than one file."

#. Speaker: RELAY
#. Intent: Partial association, never a donor map; meaningful after scene skip.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM03
msgid "dialogue.ma01.com03.relay.l001"
msgstr "Matching fragments. No original record identified."

#. Speaker: OPERATOR
#. Intent: Motivate MA02 without naming Curator or proving origin.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM03
msgid "dialogue.ma01.com03.l001"
msgstr "Its routing points to an active distribution site. Return with the package."

#. Speaker: OPERATOR
#. Intent: Manual departure; no undiscovered route mention.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM04
msgid "dialogue.ma01.com04.l001"
msgstr "Return rail released. Board your Coffin when you're ready."

#. Speaker: OPERATOR
#. Intent: Later intrusion, no revived crisis.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM01
msgid "dialogue.ma01.com01.revisit.l001"
msgstr "Archive operations have resumed. Secure local access before returning."

#. Speaker: Deployed Character
#. Intent: Same neutral source wording for all four recorded voices; later safe control inspection.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM02
msgid "dialogue.ma01.com02.revisit.l001"
msgstr "The outbound line is still isolated."

#. Speaker: OPERATOR
#. Intent: Restoration is persistent.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM02
msgid "dialogue.ma01.com02.revisit.l002"
msgstr "Leave it that way."

#. Speaker: Deployed Character
#. Intent: Safe record review; no new recovery claim.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM03
msgid "dialogue.ma01.com03.revisit.l001"
msgstr "The contained record still shows partial crew-profile matches."

#. Speaker: OPERATOR
#. Intent: Later visit; no duplicate source or story reward.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:COM03
msgid "dialogue.ma01.com03.revisit.l002"
msgstr "Review does not change its containment. Secure your return lane."

#. Speaker: Unidentified caller
#. Intent: Obscured call; no kinship, gender, name or institution. Same utterance across viewpoints, spatial mix differs.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: cutscenes/cs011.md:P03
msgid "dialogue.cs011.memory.call"
msgstr "Come inside."

#. Speaker: ROOK
#. Intent: Present-day recognition is subjective; no historical body assignment.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: cutscenes/cs011.md:P04
msgid "dialogue.cs011.rook.response"
msgstr "I know that doorway."

#. Speaker: VECTOR
#. Intent: Present-day recognition is subjective; no historical body assignment.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: cutscenes/cs011.md:P04
msgid "dialogue.cs011.vector.response"
msgstr "That boat. I've seen it before."

#. Speaker: RAM
#. Intent: Present-day recognition is subjective; no historical body assignment.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: cutscenes/cs011.md:P04
msgid "dialogue.cs011.ram.response"
msgstr "Boat got stuck. I remember that."

#. Speaker: RELAY
#. Intent: Present-day recognition is subjective; no historical body assignment.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: cutscenes/cs011.md:P04
msgid "dialogue.cs011.relay.response"
msgstr "I remember the same sound."

#. Speaker: ROOK
#. Intent: Optional two-person recognition after successful MA01; perceived viewpoint, not source ownership.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:HUB1
msgid "dialogue.ma01.hub.rook.view"
msgstr "I remember the boat from the doorway."

#. Speaker: VECTOR
#. Intent: Optional two-person recognition after successful MA01; perceived viewpoint, not source ownership.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:HUB1
msgid "dialogue.ma01.hub.vector.view"
msgstr "I was by a bench. Or I remember being there."

#. Speaker: RAM
#. Intent: Optional two-person recognition after successful MA01; perceived viewpoint, not source ownership.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:HUB1
msgid "dialogue.ma01.hub.ram.view"
msgstr "I remember the step across from the drain."

#. Speaker: RELAY
#. Intent: Optional two-person recognition after successful MA01; perceived viewpoint, not source ownership.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:HUB1
msgid "dialogue.ma01.hub.relay.view"
msgstr "The sound comes from the threshold in mine."

#. Speaker: ROOK
#. Intent: Only initiating Character's closure plays; no four-person mandatory scene.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:HUB1
msgid "dialogue.ma01.hub.rook.close"
msgstr "We'll keep the views separate."

#. Speaker: VECTOR
#. Intent: Only initiating Character's closure plays; no four-person mandatory scene.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:HUB1
msgid "dialogue.ma01.hub.vector.close"
msgstr "Same image. That doesn't tell us who lived it."

#. Speaker: RAM
#. Intent: Only initiating Character's closure plays; no four-person mandatory scene.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:HUB1
msgid "dialogue.ma01.hub.ram.close"
msgstr "Same boat. Different places."

#. Speaker: RELAY
#. Intent: Only initiating Character's closure plays; no four-person mandatory scene.
#. Source status: Working Stage-1 English; no measured voice/animation timing.
#: missions/ma01.md:HUB1
msgid "dialogue.ma01.hub.relay.close"
msgstr "Matching material does not identify who it belongs to."
